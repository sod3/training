# MongoDB Atlas or another replica set (transactions required)
MONGODB_URI=
# At least 32 cryptographically random characters; also protects queued email bodies
AUTH_SECRET=
APP_URL=http://localhost:3000
# One-time bootstrap only; never exposed to browser code
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Manual payment receiver details shown during checkout
PAYMENT_ACCOUNT_NAME=Spotter Training
JAZZCASH_ACCOUNT_NUMBER=
EASYPAISA_ACCOUNT_NUMBER=
# Private bucket with public access blocked, including for images
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for S3-compatible providers
S3_ENDPOINT=
# Safepay Express Checkout v3 and v2.0.0 payment webhooks
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_INTENT=CYBERSOURCE
# Bearer secret for /api/jobs; configure a once-per-minute scheduler
CRON_SECRET=
ALLOW_DEVELOPMENT_SEED=false
